# Database
DATABASE_URL="postgresql://mitch:password@localhost:5434/reviews"

# AI Providers
CLAUDE_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
LM_STUDIO_URL="http://172.25.208.1:1234/v1"

# Google Business Profile
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."
GOOGLE_REFRESH_TOKEN="..."
GOOGLE_ACCOUNT_ID="..."
GOOGLE_LOCATION_ID="..."

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_PASSWORD="your-secure-password"

# n8n Webhooks (outbound)
N8N_WEBHOOK_BASE="http://localhost:5678/webhook"

# Optional: Rate limits
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Cron auth (required: /api/cron/* returns 503 when this is unset)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Inbound webhook auth (required: /api/webhooks/* returns 503 when this is unset)
# Callers send it as the x-webhook-secret header.
WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"
